# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Admin account (used by `npm run seed`)
ADMIN_EMAIL="owner@heat-fitness-studio.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="HEAT Admin"

# Where over-limit notifications get emailed
ADMIN_NOTIFICATION_EMAIL="owner@heat-fitness-studio.com"

# Resend (https://resend.com) - for sending the over-limit notification email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HEAT Booking <onboarding@resend.dev>"

