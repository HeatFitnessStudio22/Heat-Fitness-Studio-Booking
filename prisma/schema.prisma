generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id            String          @id @default(cuid())
  fullName      String
  email         String          @unique
  passwordHash  String
  role          Role            @default(CUSTOMER)
  // Monthly booking limit set by the gym admin for this email.
  // null = no limit enforced.
  monthlyLimit  Int?
  createdAt     DateTime        @default(now())
  bookings      Booking[]
  waitlistEntries WaitlistEntry[]
  resetToken    String?         @unique
  resetTokenExpiresAt DateTime?
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Exact start of the 1-hour slot (stored in UTC).
  startsAt  DateTime
  status    BookingStatus @default(CONFIRMED)
  // Was the user already over their monthly limit when this booking was made?
  overLimit Boolean       @default(false)
  // When this booking was cancelled (by the customer or the admin), if ever.
  cancelledAt DateTime?
  createdAt DateTime      @default(now())

  @@index([startsAt])
  @@index([userId])
}

// A customer expressing interest in a full slot, in case someone cancels.
// Promoted FIFO (oldest createdAt first) if a cancellation frees up a spot
// at least 1.5 hours before the slot's start time.
model WaitlistEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  createdAt DateTime @default(now())
  offerToken String? @unique
  offeredAt  DateTime?

  @@unique([userId, startsAt])
  @@index([startsAt])
}

